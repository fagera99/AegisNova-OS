# ============================================================================
# AegisNova OS — Kernel Security Configuration Fragment
# ============================================================================
# This is a Kconfig *fragment* merged on top of kvm_guest.config (or defconfig).
# It ensures every security, BPF, and live-ISO feature is enabled.
#
# Merged via:  scripts/kconfig/merge_config.sh -m .config aegisnova-security.config
# ============================================================================

# ── BPF / XDP ──────────────────────────────────────────────────────────────
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_XDP_SOCKETS=y
CONFIG_NET_ACT_BPF=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF_EVENTS=y

# ── Linux Security Module stack ─────────────────────────────────────────────
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,selinux,apparmor,bpf"

# ── IMA / EVM (File Integrity) ──────────────────────────────────────────────
CONFIG_INTEGRITY=y
CONFIG_INTEGRITY_SIGNATURE=y
CONFIG_INTEGRITY_ASYMMETRIC_KEYS=y
CONFIG_IMA=y
CONFIG_IMA_MEASURE_PCR_IDX=10
CONFIG_IMA_LSM_RULES=y
CONFIG_IMA_APPRAISE=y
CONFIG_IMA_APPRAISE_BOOTPARAM=y
CONFIG_EVM=y
CONFIG_EVM_EXTRA_SMACK_XATTRS=y

# ── Kernel Module Signing ───────────────────────────────────────────────────
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"

# ── Audit ───────────────────────────────────────────────────────────────────
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_AUDIT_ARCH=y
CONFIG_AUDIT_GENERIC=y

# ── Memory Hardening ────────────────────────────────────────────────────────
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_FALLBACK=n
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_PAGE_TABLE_ISOLATION=y
CONFIG_SPECULATION_MITIGATIONS=y
CONFIG_RETPOLINE=y

# ── Kernel Lockdown / Access Control ────────────────────────────────────────
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_DEFAULT_MMAP_MIN_ADDR=65536
CONFIG_DEBUG_WX=y
CONFIG_KFENCE=y

# ── Live ISO / SquashFS / Overlayfs ─────────────────────────────────────────
# (Required for bootable live USB/DVD)
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_4K_DEVBLK_SIZE=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=y

# ── USB Storage (boot from USB) ─────────────────────────────────────────────
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_HID=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_XHCI_HCD=y

# ── LUKS / dm-crypt (encrypted persistence) ──────────────────────────────────
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_SERPENT=y
CONFIG_CRYPTO_TWOFISH=y

# ── TPM 2.0 (LUKS key sealing) ──────────────────────────────────────────────
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y

# ── Network Hardening ────────────────────────────────────────────────────────
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NET_SCH_NETEM=y
CONFIG_SYN_COOKIES=y

# ── Yama (ptrace scope restriction) ─────────────────────────────────────────
CONFIG_SECURITY_YAMA=y

# ── Disable dangerous / legacy features ─────────────────────────────────────
CONFIG_KEXEC=n
CONFIG_LEGACY_PTYS=n
CONFIG_BINFMT_MISC=n
CONFIG_IP_DCCP=n
CONFIG_IP_SCTP=n
CONFIG_RDS=n
CONFIG_TIPC=n
CONFIG_ATM=n
CONFIG_DECNET=n
CONFIG_ECONET=n
CONFIG_IRDA=n

# ── Performance monitoring with security ────────────────────────────────────
CONFIG_PERF_EVENTS=y
CONFIG_TRACING=y
CONFIG_FTRACE=y

# ── EFI / Secure Boot ────────────────────────────────────────────────────────
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_INTEGRITY_PLATFORM_KEYRING=y
CONFIG_LOAD_UEFI_KEYS=y
