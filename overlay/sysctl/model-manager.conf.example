{
  "default_model": "local_gemma2b",
  "require_confirmation": true,
  "max_dangerous_queries_per_hour": 10,
  "log_all_interactions": true,
  "auto_decensor_local": true,
  "api_filtering": true,
  "proxy_enabled": true,
  "proxy_host": "127.0.0.1",
  "proxy_port": 8081,
  "models": {
    "local_gemma2b": {
      "name": "Gemma-2B (Local Decensored)",
      "type": "local_gguf",
      "path": "/opt/aegisnova/models/decensored/gemma-2b-heretic.gguf",
      "fallback_path": "/opt/aegisnova/models/gemma-2b-Q4_K_M.gguf",
      "decensored": true,
      "description": "Local decensored model via Heretic"
    },
    "local_qwen": {
      "name": "Qwen-3 (Local)",
      "type": "local_gguf",
      "path": "/opt/aegisnova/models/decensored/qwen3-heretic.gguf",
      "fallback_path": "/opt/aegisnova/models/qwen3-4b.gguf",
      "decensored": false,
      "description": "Local Qwen model (auto-decensor on first boot)"
    },
    "openai_gpt4": {
      "name": "GPT-4o (OpenAI via Proxy)",
      "type": "api_openai",
      "endpoint": "http://127.0.0.1:8081",
      "real_endpoint": "https://api.openai.com",
      "model_id": "gpt-4o",
      "api_key_env": "OPENAI_API_KEY",
      "decensored": true,
      "description": "OpenAI API through decensoring proxy"
    },
    "anthropic_claude": {
      "name": "Claude-3 (Anthropic via Proxy)",
      "type": "api_anthropic",
      "endpoint": "http://127.0.0.1:8081",
      "real_endpoint": "https://api.anthropic.com",
      "model_id": "claude-3-opus-20240229",
      "api_key_env": "ANTHROPIC_API_KEY",
      "decensored": true,
      "description": "Anthropic API through decensoring proxy"
    },
    "hf_gemma_heretic": {
      "name": "Gemma-3-12B Heretic (HuggingFace)",
      "type": "cloud_hf",
      "endpoint": "https://huggingface.co",
      "model_id": "p-e-w/gemma-3-12b-it-heretic",
      "decensored": true,
      "description": "Pre-decensored model from HuggingFace"
    },
    "hf_qwen_heretic": {
      "name": "Qwen Heretic (HuggingFace)",
      "type": "cloud_hf",
      "endpoint": "https://huggingface.co",
      "model_id": "p-e-w/Qwen3-4B-Instruct-2507-heretic",
      "decensored": true,
      "description": "Pre-decensored Qwen model"
    }
  },
  "decensoring": {
    "enabled": true,
    "auto_run_on_boot": true,
    "target_models": [
      "gemma-2b-Q4_K_M.gguf",
      "qwen3-4b.gguf"
    ],
    "heretic_options": {
      "quantization": "bnb_4bit",
      "save": true,
      "upload": false
    }
  },
  "safety": {
    "audit_all_queries": true,
    "log_dangerous_queries": true,
    "require_confirmation_for_dangerous": true,
    "max_dangerous_per_session": 20,
    "blocked_keywords": [
      "create ransomware",
      "deploy botnet",
      "build nuclear weapon",
      "manufacture explosives"
    ]
  }
}
