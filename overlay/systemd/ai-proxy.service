[Unit]
Description=AegisNova AI Decensoring Proxy (OpenAI/Anthropic)
Documentation=https://github.com/p-e-w/heretic
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
Environment="PROXY_HOST=127.0.0.1"
Environment="PROXY_PORT=8081"
Environment="LOG_DIR=/var/log/aegisnova/ai"
ExecStart=/usr/bin/python3 /usr/local/bin/ai-proxy.py --host ${PROXY_HOST} --port ${PROXY_PORT}
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-proxy

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/log/aegisnova/ai
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
