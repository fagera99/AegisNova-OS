[Unit]
Description=AegisNova Secure Memory Wipe (on shutdown)
DefaultDependencies=false
Before=shutdown.target reboot.target halt.target

# ═══════════════════════════════════════════════════════════
# This service runs during system shutdown to securely clear
# sensitive data from RAM before power off.
# ═══════════════════════════════════════════════════════════

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/bin/aegisnova-wipe.sh --memory
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
