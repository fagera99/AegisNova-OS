# AegisNova OS — Environment Configuration
# Copy to /etc/aegisnova/env and set your values.
# This file should be chmod 600 and owned by root.

# ── LLM Backend ──
# Provider: local (default), openai, anthropic, ollama
LLM_PROVIDER=local
LLM_MODEL=gemma-2b-Q4_K_M

# For OpenAI
# OPENAI_API_KEY=sk-...

# For Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# For Ollama
# OLLAMA_HOST=http://localhost:11434

# ── eBPF Sensor ──
LLM_ENDPOINT=http://127.0.0.1:8080/completion
ALERT_THRESHOLD=medium
WEBHOOK_URL=

# ── Jupyter ──
JUPYTER_TOKEN=aegisnova2024

# ── Metasploit ──
MSF_PASSWORD=changeme

# ── Theme ──
THEME_MODE=dark
